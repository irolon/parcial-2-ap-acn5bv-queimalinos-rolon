# Copiá este archivo a n8n/.env (está ignorado por git) y completá los valores.

# Clave con la que n8n cifra las credenciales guardadas. Generala una vez (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") y no la cambies después.
# Si la definís, tiene que ser la misma desde el primer arranque del volumen.
# N8N_ENCRYPTION_KEY=
# Zona horaria de los nodos de n8n que usan fechas.
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
# Zona horaria del contenedor.
TZ=America/Argentina/Buenos_Aires
# En false para entrar al editor por http://localhost; con HTTPS (producción) va en true.
N8N_SECURE_COOKIE=false
# Base de la API compatible con OpenAI que usan los workflows: KIMI (Moonshot, prepago en platform.moonshot.ai).
LLM_BASE_URL=https://api.moonshot.ai/v1
# Modelo del workflow del entrenador (trainer-ia).
LLM_TRAINER_MODEL=kimi-k3.1-pro
# Modelo del workflow del alumno (student-ia).
LLM_STUDENT_MODEL=kimi-k3.1-pro
# Campos extra del pedido, como objeto JSON (pisan temperature, max_tokens y response_format; nunca model ni messages).
# Vacío = el de KIMI: {"thinking":{"type":"disabled"},"temperature":0.6} (razonamiento apagado; así KIMI solo acepta 0.6).
# {} = no mandar nada extra.
# Alternativa gratis, NVIDIA (ver n8n/README.md). Cambiá las cuatro variables juntas: si dejás LLM_EXTRA_BODY vacío,
# a NVIDIA le llega el extra de KIMI. LLM_BASE_URL=https://integrate.api.nvidia.com/v1,
# modelos nvidia/nemotron-3.5-lightning-30b-a3b y LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}.
LLM_EXTRA_BODY=
# Desde n8n 2.x los nodos Code no leen $env por defecto; en false los workflows pueden leer las variables de arriba.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
