# ── Servidor ────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Supabase ────────────────────────────────
# Settings → API en el dashboard de Supabase
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── JWT ─────────────────────────────────────
# Secreto para firmar los tokens de acceso. Mínimo 32 caracteres aleatorios.
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Proxy y rate limiting ───────────────────
# Saltos de proxy delante del backend (en el VPS detrás de nginx: 1). Vacío = trust proxy apagado.
# Obligatoria con NODE_ENV=production (si falta, no arranca); 0 = sin proxy.
TRUST_PROXY=
# Ventana (ms) y máximos por ventana. Vacío = valores por defecto (15 min; login 10 por IP + email y
# 50 por IP, register/refresh 30, invitación pública y alta de alumno 30). En NODE_ENV=test los valores
# por defecto son 100 veces mayores.
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_IP_MAX=
RATE_LIMIT_AUTH_MAX=
RATE_LIMIT_PUBLIC_MAX=

# ── Jobs programados ────────────────────────
# Jobs nocturnos de gamificación e inactividad (03:00 Buenos Aires). 'false' lo apaga; en test siempre está apagado.
CRON_ENABLED=true

# ── Push (Firebase Cloud Messaging, HTTP v1) ──
# Cuenta de servicio de Firebase. Opcionales: sin ellas el push queda deshabilitado (la notificación igual se guarda).
# Desarrollo local: ruta al JSON descargado de Firebase (no commitear).
FCM_SERVICE_ACCOUNT_PATH=
# VPS: el mismo JSON codificado en base64 (p. ej. base64 -w0 service-account.json).
FCM_SERVICE_ACCOUNT_JSON=

# ── n8n (asistentes IA) ─────────────────────
# Opcionales: la app arranca sin ellas, pero cada asistente necesita su URL y el secreto;
# si falta alguna responde 503 sin llamar a n8n.
# Webhook del workflow trainer-ia (asistente IA del entrenador). Ver n8n/README.md.
N8N_TRAINER_AI_WEBHOOK_URL=
# Webhook del workflow student-ia (chat IA del alumno durante la sesión). Ver n8n/README.md.
N8N_STUDENT_AI_WEBHOOK_URL=
# Secreto compartido por los dos: va en el header x-webhook-secret y n8n lo compara (credencial Header Auth).
N8N_WEBHOOK_SECRET=
