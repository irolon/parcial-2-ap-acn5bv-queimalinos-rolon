{
  "root": true,
  "ignorePatterns": ["coverage/"],
  "env": {
    "node": true,
    "es2022": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": ["eslint:recommended", "prettier"],
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "ignoreRestSiblings": true }],
    "no-console": "off",
    "max-lines": ["error", { "max": 200, "skipBlankLines": false, "skipComments": false }]
  }
}
