# Variables del dashboard web (React + Vite).
# Copiar a `frontend/.env` y completar. NUNCA commitear el .env con valores reales.
#
# ⚠️ Vite solo expone al browser las variables con prefijo VITE_, y las hornea en
# el bundle en tiempo de build. Todo lo que pongas acá es PÚBLICO: no metas
# nunca la service_role key de Supabase ni el JWT_SECRET.

# ── API ─────────────────────────────────────
# Backend levantado con docker compose up.
VITE_API_URL=http://localhost:3001/api

# ── App ─────────────────────────────────────
VITE_APP_NAME=FitTrainer
