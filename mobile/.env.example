# Variables de la app Android (Kotlin).
# Copiar a `mobile/.env` y completar. NUNCA commitear el .env con valores reales.
#
# En Android estas variables no se leen en runtime: se inyectan como campos de
# BuildConfig desde build.gradle. El archivo existe para que la configuración
# esté documentada en un solo lugar, igual que en backend y frontend.


# ══════════════════════════════════════════════════════════════════════════
#  ⚠️  EN EL EMULADOR, LA URL DE LA API NO ES localhost
# ══════════════════════════════════════════════════════════════════════════
#
# Dentro del emulador de Android, `localhost` es el emulador mismo, no tu PC.
# Si apuntás a localhost, la app falla con "Connection refused" y parece que el
# backend está caído cuando en realidad está andando perfecto.
#
# En desarrollo la API va por HTTP y la app solo lo permite contra dos hosts
# (res/xml/network_security_config.xml), así que hay dos opciones:
#
#   Emulador de Android Studio → http://10.0.2.2:3001/api   (alias de tu PC)
#   Celular físico por USB     → http://localhost:3001/api
#                                 antes: `adb reverse tcp:3001 tcp:3001`
#
# Cualquier otro host (Genymotion, la IP de tu PC por wifi, etc.) tiene que ir
# por HTTPS: con HTTP la app corta la conexión.
#
# El backend escucha en el puerto 3001.

API_BASE_URL=http://10.0.2.2:3001/api


# ── Red ─────────────────────────────────────
# Timeout de las llamadas HTTP, en segundos.
API_TIMEOUT_SECONDS=30


# ── Links de invitación ─────────────────────
# Host de los links de invitación que abre la app (el de FRONTEND_URL del backend, sin puerto).
JOIN_LINK_HOST=localhost
# Android 12+: un link sin verificar abre el navegador. En el celular de desarrollo:
# adb shell pm set-app-links-user-selection --user cur --package com.fittrainer true localhost
