# Variables de la app Android (Kotlin).
# Copiar a `mobile/.env` y completar. NUNCA commitear el .env con valores reales.
#
# En Android estas variables no se leen en runtime: se inyectan como campos de
# BuildConfig desde build.gradle. El archivo existe para que la configuración
# esté documentada en un solo lugar, igual que en backend y frontend.


# ══════════════════════════════════════════════════════════════════════════
#  ⚠️  LA URL DE LA API NO ES localhost
# ══════════════════════════════════════════════════════════════════════════
#
# Dentro del emulador de Android, `localhost` es el emulador mismo, no tu PC.
# Si apuntás a localhost, la app falla con "Connection refused" y parece que el
# backend está caído cuando en realidad está andando perfecto.
#
# La dirección correcta depende de dónde corras la app:
#
#   Emulador de Android Studio → 10.0.2.2   (alias del host desde el emulador)
#   Emulador de Genymotion     → 10.0.3.2
#   Celular físico por wifi    → la IP de tu PC en la red local (ej. 192.168.0.15)
#                                 ambos tienen que estar en la misma red, y el
#                                 firewall de Windows tiene que dejar pasar el 3001
#
# El puerto es el mismo que publica docker-compose.yml: 3001.

API_BASE_URL=http://10.0.2.2:3001/api


# ── Red ─────────────────────────────────────
# Timeout de las llamadas HTTP, en segundos.
API_TIMEOUT_SECONDS=30

# Android 9+ bloquea el tráfico HTTP en texto plano por defecto. Para desarrollo
# contra 10.0.2.2 hay que permitirlo explícitamente en network_security_config.xml
# (solo para ese host). En producción la API va por HTTPS y esto no hace falta.
ALLOW_CLEARTEXT_TRAFFIC=true
